{
  "name": "@drawroid/cli",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "drawroid": "./bundle/index.js"
  },
  "files": [
    "bundle"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:incremental": "tsc -p tsconfig.build.json --incremental --tsBuildInfoFile dist/tsconfig.build.tsbuildinfo",
    "dev": "pnpm run build:incremental --watch --preserveWatchOutput",
    "dev:serve": "node --watch dist/index.js",
    "bundle": "node scripts/bundle.mjs",
    "prepack": "pnpm run bundle",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@drawroid/api": "workspace:*",
    "@drawroid/backend-a1111": "workspace:*",
    "@drawroid/backend-forge": "workspace:*",
    "@drawroid/core": "workspace:*",
    "@drawroid/llm": "workspace:*",
    "@drawroid/storage-fs": "workspace:*",
    "@drawroid/web": "workspace:*",
    "@hono/node-server": "catalog:",
    "@types/node": "catalog:",
    "esbuild": "^0.28.2",
    "hono": "catalog:",
    "typescript": "catalog:",
    "vitest": "^5.0.0",
    "zod": "catalog:"
  }
}
