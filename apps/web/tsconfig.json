{
  "extends": "../../tsconfig.base.json",
  "include": ["app", "*.ts", ".react-router/types/**/*"],
  "compilerOptions": {
    // ブラウザで動くので base（Node 前提・ES2023 のみ）を上書きする
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node", "vite/client"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "declaration": false,
    // react-router typegen が `./+types/*` をここへ吐く
    "rootDirs": [".", "./.react-router/types"],
    "paths": {
      // `@drawroid/ui` の中の shadcn の部品は `@/lib/utils` の形で互いを import する（`packages/ui/components.json` の aliases）。
      // この画面の型検査は import 先の `packages/ui` のソースまで辿るので、同じ対応をここにも置く。
      // **画面のコードからは `@/` を使わない**（`eslint.config.js` が止める）。
      "@/*": ["../../packages/ui/src/*"]
    }
  }
}
