{
  "name": "drawroid-monorepo",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.28.2",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "dev": "pnpm -r --filter=!@drawroid/web --if-present run build:incremental && pnpm -r --parallel run /^dev/",
    "start": "node scripts/start.mjs",
    "drawroid": "node apps/cli/dist/index.js",
    "typecheck": "pnpm -r --if-present typecheck && tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "format": "prettier --write .",
    "storybook": "pnpm --filter @drawroid/ui storybook",
    "format:check": "prettier --check .",
    "check:no-attribution-trailers": "node ./scripts/check-no-attribution-trailers.mjs",
    "check:duplicate-json-keys": "node ./scripts/check-duplicate-json-keys.mjs",
    "check:packed-install": "node ./scripts/check-packed-install.mjs",
    "check:packed-conversation": "node ./scripts/check-packed-conversation.mjs",
    "check:packed-browser": "node ./scripts/check-packed-browser.mjs",
    "check:packed-browser-conversation": "node ./scripts/check-packed-browser-conversation.mjs",
    "check:packed-browser-long-conversation": "node ./scripts/check-packed-browser-long-conversation.mjs",
    "check:packed-browser-image-viewer": "node ./scripts/check-packed-browser-image-viewer.mjs",
    "check:packed-browser-viewer-mask": "node ./scripts/check-packed-browser-viewer-mask.mjs",
    "check:packed-browser-stop-conditions": "node ./scripts/check-packed-browser-stop-conditions.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "catalog:",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "playwright-core": "^1.64.0",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "^8.67.0",
    "vitest": "^5.0.0"
  }
}
