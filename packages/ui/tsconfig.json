{
  "extends": "../../tsconfig.base.json",
  "include": ["src", ".storybook/**/*.ts", ".storybook/**/*.tsx"],
  "compilerOptions": {
    // apps/web と同じ世界（Vite が束ねるブラウザ向けのソース）で書かれているので、
    // base（Node 前提・NodeNext・ES2023 のみ）を apps/web/tsconfig.json と同じ形に上書きする。
    // このパッケージは build を持たず、ソースのまま apps/web の Vite に読ませる。
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node", "vite/client"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "declaration": false,
    // `@/` は shadcn の部品が互いを import する形（`components.json` の aliases）のまま使うための別名。
    // 対応は ui の tsconfig・`.storybook/main.ts`・apps/web/tsconfig.json・根の vitest.config.ts の4か所
    "paths": { "@/*": ["./src/*"] }
  }
}
