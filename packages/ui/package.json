{
  "name": "@drawroid/ui",
  "version": "0.0.0",
  "private": true,
  "description": "Web UI の見た目の部品（shadcn の部品・画面向けの部品・テーマの CSS）。API も router も知らない。",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./shadcn": "./src/components/ui/index.ts",
    "./styles.css": "./src/styles.css"
  },
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "shadcn:add": "node ./scripts/shadcn-add.mjs"
  },
